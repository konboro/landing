# ─────────────────────────────────────────────────────────────
# Penny Platform — environment template. Copy to .env.local per app.
# NEVER commit real secrets. service_role only in edge fns + gateway.
# ─────────────────────────────────────────────────────────────

# Supabase
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=eyJ...anon
SUPABASE_SERVICE_ROLE_KEY=eyJ...service_role   # edge/gateway ONLY

# Admin panel (Vite — must be prefixed VITE_)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...anon
VITE_MAPBOX_TOKEN=pk.eyJ...mapbox
VITE_EDGE_BASE_URL=https://YOUR_PROJECT.supabase.co/functions/v1

# Rider/Ops apps (Expo — must be prefixed EXPO_PUBLIC_)
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJ...anon
EXPO_PUBLIC_MAPBOX_TOKEN=pk.eyJ...mapbox
EXPO_PUBLIC_EDGE_BASE_URL=https://YOUR_PROJECT.supabase.co/functions/v1

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Sumsub (KYC)
SUMSUB_APP_TOKEN=sbx:...
SUMSUB_SECRET_KEY=...

# Resend (email)
RESEND_API_KEY=re_...

# SMS provider (gateway fallback)
SMS_PROVIDER_KEY=

# Gateway (Go)
PORT=5027
METRICS_PORT=9100
DB_URL=postgres://postgres:postgres@localhost:5432/postgres
PGMQ_QUEUE=commands
CMD_TIMEOUT_MS=8000
CMD_SMS_ESCALATE_MS=5000
SESSION_IDLE_CLOSE_S=300

# Anthropic (photo-review AI pre-screen)
ANTHROPIC_API_KEY=sk-ant-...
