# React Native + pnpm.
#
# `hoisted` is what the React Native docs ask for with pnpm, and on Windows it is
# not optional: the default isolated layout nests native modules under
# `node_modules/.pnpm/<name>_<hash>/node_modules/...`, and adding CMake's own
# `android/.cxx/Debug/<hash>/prefab/<abi>/prefab/lib/<triple>/cmake/...` on top
# pushes the path past the 260-character MAX_PATH limit. Gradle then fails with
#   ninja: error: rebuilding 'build.ninja': Stat(...): Filename longer than 260 characters
# on react-native-gesture-handler. Hoisting drops ~70 characters and clears it.
node-linker=hoisted
