# Penny Rider — Expo env. Copy to `.env.local` (gitignored). All client-visible
# vars MUST be prefixed EXPO_PUBLIC_.
#
# EXPO_PUBLIC_* values are inlined into the JS bundle when it is built, not read
# at runtime. Adding one therefore needs Metro restarted from scratch — a reload
# keeps serving the bundle that was built without it.

# Data source: 'mock' (default, fully offline) or 'supabase' (live backend).
EXPO_PUBLIC_DATA_SOURCE=mock

# Live backend (only needed when DATA_SOURCE=supabase)
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJ...anon
EXPO_PUBLIC_EDGE_BASE_URL=https://YOUR_PROJECT.supabase.co/functions/v1

# Map: leave UNSET to use the graceful fallback map (works in Expo Go).
# Set a real Mapbox public token (pk.*) to enable the native @rnmapbox/maps view
# in a dev/native build.
# EXPO_PUBLIC_MAPBOX_TOKEN=pk.eyJ...

# Stripe. REQUIRED for anything that takes money — adding a card, topping up,
# buying a package. Without it StripeSvc.available() is false and the app reports
# "Stripe is not configured." rather than opening PaymentSheet, which is the
# usual reason a fresh checkout cannot add a card.
#
# It is a publishable key: safe in the client, that is what it is for. Ask for
# the project's test key rather than inventing one — it has to belong to the same
# Stripe account as the server's STRIPE_SECRET_KEY, or the client secret the
# server issues will be rejected.
#
# Needs a dev/native build: @stripe/stripe-react-native is a native module and
# does not exist in Expo Go.
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Native Mapbox SDK download token (build-time only, not client-visible).
# MAPBOX_DOWNLOAD_TOKEN=sk...
