# Penny Rider — Expo env. Copy to `.env.local` (gitignored). All client-visible
# vars MUST be prefixed EXPO_PUBLIC_.

# Data source: 'mock' (default, fully offline) or 'supabase' (live backend).
EXPO_PUBLIC_DATA_SOURCE=mock

# Live backend (only needed when DATA_SOURCE=supabase)
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJ...anon
EXPO_PUBLIC_EDGE_BASE_URL=https://YOUR_PROJECT.supabase.co/functions/v1

# Map: leave UNSET to use the graceful fallback map (works in Expo Go).
# Set a real Mapbox public token (pk.*) to enable the native @rnmapbox/maps view
# in a dev/native build.
# EXPO_PUBLIC_MAPBOX_TOKEN=pk.eyJ...

# Stripe (PaymentSheet) — placeholder; used in a native/dev build.
# EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Native Mapbox SDK download token (build-time only, not client-visible).
# MAPBOX_DOWNLOAD_TOKEN=sk...
