# Penny Ops — copy to .env.local. Defaults run the app fully standalone (mock).
# Expo public env MUST be prefixed EXPO_PUBLIC_.

# 'mock' (default, no backend needed) or 'supabase'
EXPO_PUBLIC_DATA_SOURCE=mock

# Live Mapbox map (optional). Without a pk.* token the app renders the styled
# map fallback + vehicle list, so it still runs in Expo Go.
EXPO_PUBLIC_MAPBOX_TOKEN=

# Only needed when EXPO_PUBLIC_DATA_SOURCE=supabase
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_EDGE_BASE_URL=
