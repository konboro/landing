# Penny Admin — copy to .env.local. All client vars MUST be prefixed VITE_.

# Which data source the panel reads from. Default = mock (runs standalone).
# Set to 'supabase' only once the backend + edge functions are wired.
VITE_DATA_SOURCE=mock

# Mapbox GL token. If omitted/invalid, maps render a graceful fallback
# ("map unavailable — add token") and the rest of the panel still works.
VITE_MAPBOX_TOKEN=

# Pin this deployment to a built-in operator brand (white-label).
# One of: penny (default) | aegean | volta — see src/context/BrandContext.tsx.
# Leave empty to let app_config.brand (editable in Settings -> Branding) decide.
VITE_BRAND=

# Only needed when VITE_DATA_SOURCE=supabase
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_EDGE_BASE_URL=
