# Penny Admin — copy to .env.local. All client vars MUST be prefixed VITE_.
#
# There is no mock mode any more: the panel reads the live project or it shows
# an error. Without the two Supabase vars below it will not sign in at all.

# Supabase project. The anon key is public by design — it ships inside the
# client bundle and every read it can make is gated by RLS. Dashboard ->
# Project Settings -> API. The service_role key belongs ONLY in edge functions
# and the gateway; never put it here.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...

# Mapbox GL token. If omitted/invalid, maps render a graceful fallback
# ("map unavailable — add token") and the rest of the panel still works.
VITE_MAPBOX_TOKEN=

# Pin this deployment to a built-in operator brand (white-label).
# One of: penny (default) | aegean | volta — see src/context/BrandContext.tsx.
# Leave empty to let app_config.brand (editable in Settings -> Branding) decide.
VITE_BRAND=
